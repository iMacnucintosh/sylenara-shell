# Maintainer: iMacnucintosh
# Sylenara: a Material You shell for Hyprland (Quickshell), built from the git repository.
#   cd packaging && makepkg -si
pkgname=sylenara-shell-git
pkgver=0.3.0.r0.g0000000
pkgrel=1
pkgdesc="Sylenara: a Material You shell for Hyprland (Quickshell)"
arch=('x86_64')
url="https://github.com/iMacnucintosh/sylenara-shell"
# The shell is GPL-3.0; the wallpaper in assets/wallpapers has its own licence (see its README)
license=('GPL-3.0-only' 'LicenseRef-Unsplash')
# No debug package: nobody installs the symbols of this one
options=('!debug')
depends=(
  # What it is made on (the git Quickshell: the stable tag lacks what the shell uses)
  'quickshell-git' 'hyprland' 'qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-svg'
  'qt6-imageformats' 'qt6-m3shapes-git' 'libqalculate' 'libpipewire' 'aubio' 'libcava'
  'xdg-desktop-portal-hyprland' 'xdg-desktop-portal-gtk'
  # What its scripts and services call
  'python' 'python-gobject' 'networkmanager' 'wireplumber' 'libpulse' 'libxml2' 'curl' 'systemd' 'brightnessctl' 'lm_sensors'
  'power-profiles-daemon' 'cliphist' 'wl-clipboard' 'wtype' 'grim' 'slurp' 'libnotify' 'qt6ct'
  # Look: icons and GTK theme that follow the colours of the shell (sylenara-quiet writes their settings)
  'papirus-icon-theme' 'adw-gtk-theme'
  # Fonts of the interface (Rubik: the clock and the desktops, from the AUR)
  'ttf-material-symbols-variable' 'ttf-cascadia-code-nerd' 'ttf-rubik-vf'
  # Screen recording (syl record, the quick toggles) and the brightness of external monitors (DDC/CI)
  'gpu-screen-recorder' 'ddcutil'
  # The CLI and the apps that come with it (Veo goes in optdepends: see there)
  'sylenara-cli-git' 'things-git' 'seeker-git' 'kitty'
)
makedepends=('git' 'cmake' 'ninja' 'qt6-shadertools' 'gettext')
# Veo is installed by the Sylenara installer and its updates. It is not a hard dependency because a shell older than
# 0.6 updates with its own installer, which does not know Veo: makepkg -s cannot fetch it, and the update failed
optdepends=('veo-git: the video player of Sylenara (its installer and updates install it)'
            'fish: the calculator of the launcher opens qalc in it'
            'greetd: the login screen (scripts/install-system.sh)')
provides=('sylenara-shell')
conflicts=('sylenara-shell')
# SYLENARA_REF=<tag> builds that release (the Sylenara installer and its updates set it); without it, the latest commit
source=("git+${url}.git${SYLENARA_REF:+#tag=$SYLENARA_REF}")
sha256sums=('SKIP')

pkgver() {
  cd sylenara-shell
  # Our own versions are the v0.* tags (the project this forked has v1.* and v2.*)
  git describe --tags --long --match 'v0.*' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd sylenara-shell
  # VERSION comes from `git describe --match v0.*` (what extensions compare `requires.sylenara` with)
  cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DINSTALL_QSCONFDIR=/etc/xdg/quickshell/sylenara
  cmake --build build
}

package() {
  cd sylenara-shell
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  # The wallpaper is not GPL: its licence and author travel with the package
  install -Dm644 assets/wallpapers/README.md "$pkgdir/usr/share/licenses/$pkgname/wallpaper-licence.md"
  # ddcutil talks to monitors through i2c-dev: load it at boot
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/modules-load.d/sylenara-i2c-dev.conf" <<< "i2c-dev"
}
